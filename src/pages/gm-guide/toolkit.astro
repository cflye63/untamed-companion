				color: var(--amber);
				text-decoration: none;
				letter-spacing: 0.2rem;
			}

			.nav-links {
				display: flex;
				gap: 2rem;
			}

			.nav-links a {
				color: var(--cream);
				text-decoration: none;
				font-weight: 500;
				transition: color 0.3s;
			}

			.nav-links a:hover,
			.nav-links a.active {
				color: var(--amber);
			}

			/* Breadcrumb */
			.breadcrumb {
				padding: 2rem 0 1rem;
			}

			.breadcrumb a {
				color: var(--leaf-green);
				text-decoration: none;
				font-weight: 500;
			}

			.breadcrumb a:hover {
				color: var(--amber);
			}

			/* Page Header */
			.page-header {
				padding: 2rem 0 2rem;
				text-align: center;
				border-bottom: 2px solid var(--amber);
				margin-bottom: 2rem;
			}

			.page-header h1 {
				font-size: 3rem;
				color: var(--amber);
				margin-bottom: 0.5rem;
			}

			.subtitle {
				font-size: 1.25rem;
				color: var(--leaf-green);
				font-style: italic;
			}

			/* Content */
			.content {
				padding-bottom: 4rem;
			}

			.intro-text {
				background: var(--forest-green);
				padding: 1.25rem 1.5rem;
				border-radius: 8px;
				border-left: 4px solid var(--amber);
				color: var(--cream);
				font-style: italic;
			}

			/* Major Sections */
			.major-section {
				margin-bottom: 3rem;
				scroll-margin-top: 100px;
			}

			.section-title {
				font-size: 2rem;
				color: var(--amber);
				margin-bottom: 1.25rem;
				padding-bottom: 0.75rem;
				border-bottom: 3px solid var(--amber);
			}

			.major-section h3 {
				color: var(--leaf-green);
				font-size: 1.4rem;
				margin: 1.75rem 0 0.75rem;
			}

			.major-section h4 {
				color: var(--amber);
				font-size: 1.15rem;
				margin: 1.25rem 0 0.5rem;
			}

			.major-section p {
				margin: 0.5rem 0;
			}

			.major-section ul,
			.major-section ol {
				margin: 0.5rem 0 0.75rem 1.5rem;
			}

			.major-section li {
				margin-bottom: 0.35rem;
			}

			/* Tables */
			.table-wrapper {
				overflow-x: auto;
				margin: 1rem 0 1.5rem;
				background: var(--forest-dark);
				border-radius: 8px;
				border: 2px solid var(--earth-brown);
			}

			.table-wrapper table {
				width: 100%;
				border-collapse: collapse;
				background: var(--forest-dark);
			}

			.table-wrapper th,
			.table-wrapper td {
				padding: 0.85rem 1rem;
				text-align: left;
				border-bottom: 1px solid var(--earth-brown);
				vertical-align: top;
			}

			.table-wrapper th {
				background: var(--moss-green);
				color: var(--amber);
				font-weight: 600;
				white-space: nowrap;
			}

			.table-wrapper tr:last-child td {
				border-bottom: none;
			}

			.table-wrapper tbody tr:hover {
				background: var(--forest-green);
			}

			/* Quote */
			.quote {
				background: var(--forest-dark);
				padding: 1.25rem 1.5rem;
				border-left: 4px solid var(--amber);
				border-radius: 6px;
				margin: 1.25rem 0;
				font-style: italic;
				color: var(--cream);
				font-size: 1.1rem;
			}

			/* Callout */
			.callout {
				background: var(--forest-dark);
				padding: 1rem 1.25rem;
				border-radius: 8px;
				border-left: 4px solid var(--amber);
				margin: 1rem 0;
				color: var(--cream);
			}

			.callout strong {
				color: var(--amber);
			}

			/* Responsive */
			@media (max-width: 768px) {
				.nav .container {
					flex-direction: column;
					gap: 1rem;
				}

				.nav-links {
					gap: 1rem;
					flex-wrap: wrap;
					justify-content: center;
				}

				.page-header h1 {
					font-size: 2rem;
				}

				.section-title {
					font-size: 1.5rem;
				}

				.table-wrapper th,
				.table-wrapper td {
					padding: 0.6rem 0.75rem;
					font-size: 0.95rem;
				}
			}
		</style>
	</body>
</html>
