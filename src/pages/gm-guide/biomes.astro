				padding-bottom: 4rem;
			}

			/* Major Sections */
			.major-section {
				margin-bottom: 4rem;
				scroll-margin-top: 100px;
				background: var(--forest-green);
				padding: 2rem;
				border-radius: 12px;
				border: 2px solid var(--earth-brown);
