			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			:root {
				--forest-dark: #1a2e1a;
				--forest-green: #2d5016;
				--moss-green: #4a7c2f;
				--leaf-green: #6b9d3a;
