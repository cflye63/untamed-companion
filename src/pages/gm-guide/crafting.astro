					gap: 1rem;
					flex-wrap: wrap;
					justify-content: center;
				}

				.page-header h1 {
					font-size: 2rem;
				}

				.section-title {
					font-size: 1.6rem;
				}

				.rule-section {
					padding: 1.25rem;
				}

				.comparison {
					grid-template-columns: 1fr;
				}

				.toc-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
